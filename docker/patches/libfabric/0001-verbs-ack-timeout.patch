 		conn_param.srq = 1;
 	conn_param.qp_num = ep->tgt_ibv_qp->qp_num;
 
+	vrb_set_ack_timeout(id);
 	return rdma_accept(id, &conn_param);
 }
 
@@ -359,6 +360,7 @@ int vrb_accept_xrc(struct vrb_xrc_ep *ep, int reciprocal,
 	       ep->conn_state == VRB_XRC_ORIG_CONNECTED);
 	vrb_next_xrc_conn_state(ep);
 
+	vrb_set_ack_timeout(ep->tgt_id);
 	ret = rdma_accept(ep->tgt_id, &conn_param);
 	if (OFI_UNLIKELY(ret)) {
 		ret = -errno;
