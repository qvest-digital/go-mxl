verbs: make the rdma_cm local ACK timeout configurable

rdma_cm derives the RoCE local ACK timeout from a fixed packet
lifetime of 16, so every RC QP it sets up retries after
4.096 us * 2^17 = 537 ms. A loss of the last packets of an RDMA write
produces no NAK, so only that timer recovers it and the QP stalls for
over half a second per lost tail.

FI_VERBS_ACK_TIMEOUT sets the exponent (1 - 31) through
rdma_set_option(RDMA_OPTION_ID_ACK_TIMEOUT) on the active side before
route resolution and on the passive side before accept. The default,
-1, leaves the kernel's choice in place; an out-of-range value is
ignored with a warning rather than disabling the provider.

Applies to libfabric v2.6.0 (prov/verbs).

diff --git a/prov/verbs/src/verbs_cm.c b/prov/verbs/src/verbs_cm.c
index 5f4a7ed..734246d 100644
--- a/prov/verbs/src/verbs_cm.c
+++ b/prov/verbs/src/verbs_cm.c
@@ -121,6 +121,19 @@ vrb_msg_ep_prepare_cm_data(const void *param, size_t param_size,
 	memcpy(cm_hdr->data, param, cm_hdr->size);
 }
 
+void vrb_set_ack_timeout(struct rdma_cm_id *id)
+{
+	uint8_t timeout;
+
+	if (vrb_gl_data.ack_timeout < 0)
+		return;
+
+	timeout = (uint8_t) vrb_gl_data.ack_timeout;
+	if (rdma_set_option(id, RDMA_OPTION_ID, RDMA_OPTION_ID_ACK_TIMEOUT,
+			    &timeout, sizeof(timeout)))
+		VRB_WARN_ERRNO(FI_LOG_EP_CTRL, "rdma_set_option ACK_TIMEOUT");
+}
+
 static inline void
 vrb_ep_prepare_rdma_cm_param(struct rdma_conn_param *conn_param,
 				void *priv_data, size_t priv_data_size)
@@ -255,6 +268,7 @@ vrb_msg_ep_accept(struct fid_ep *ep, const void *param, size_t paramlen)
 	ofi_genlock_lock(&vrb_ep2_progress(_ep)->ep_lock);
 	assert(_ep->state == VRB_REQ_RCVD);
 	_ep->state = VRB_ACCEPTING;
+	vrb_set_ack_timeout(_ep->id);
 	vrb_prof_func_start("rdma_accept");
 	ret = rdma_accept(_ep->id, &conn_param);
 	vrb_prof_func_end("rdma_accept");
